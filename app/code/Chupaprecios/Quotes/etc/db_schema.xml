<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <!-- Tabla quote_request -->
    <table name="quote_request" resource="default" engine="innodb" comment="Quote Request Table">
        <column xsi:type="int" name="quote_id" nullable="false" unsigned="true" identity="true" comment="Quote ID"/>
        <column xsi:type="int" name="cart_id" nullable="false" comment="Cart ID"/>
        <column xsi:type="int" name="customer_id" nullable="true" unsigned="true" comment="Customer ID"/>
        <column xsi:type="boolean" name="customer_is_guest" nullable="false" default="0" comment="Is Guest"/>
        <column xsi:type="boolean" name="status" nullable="false" default="1" comment="Status"/>
        <column xsi:type="decimal" name="subtotal" nullable="false" precision="12" scale="4" comment="Subtotal"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="quote_id"/>
        </constraint>
        <index referenceId="QUOTE_REQUEST_QUOTE_ID" indexType="btree">
            <column name="cart_id"/>
        </index>
        <index referenceId="QUOTE_REQUEST_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <!-- Índice en customer_id -->
        <constraint xsi:type="foreign" referenceId="FK_QUOTE_REQUEST_CUSTOMER" table="quote_request" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
    </table>

    <!-- Tabla quote_request_detail -->
    <table name="quote_request_detail" resource="default" engine="innodb" comment="Quote Request Details Table">
        <column xsi:type="int" name="detail_id" nullable="false" unsigned="true" identity="true" comment="Detail ID"/>
        <column xsi:type="int" name="quote_id" nullable="false" unsigned="true" comment="Quote ID"/>
        <column xsi:type="int" name="product_id" nullable="false" unsigned="true" comment="Product ID"/>
        <column xsi:type="varchar" name="product_sku" nullable="false" length="64" comment="Product SKU"/>
        <column xsi:type="decimal" name="price" nullable="false" precision="12" scale="4" comment="Price"/>
        <column xsi:type="int" name="quantity" nullable="false" comment="Quantity"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <index referenceId="QUOTE_REQUEST_DETAIL_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
        <index referenceId="QUOTE_REQUEST_DETAIL_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="detail_id"/>
        </constraint>

        <!-- Foreign key a quote_request -->
        <constraint xsi:type="foreign" referenceId="FK_QUOTE_REQUEST_DETAIL_QUOTE" table="quote_request_detail" column="quote_id" referenceTable="quote_request" referenceColumn="quote_id" onDelete="CASCADE"/>

        <!-- Foreign key a catalog_product_entity -->
        <constraint xsi:type="foreign" referenceId="FK_QUOTE_REQUEST_DETAIL_PRODUCT" table="quote_request_detail" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>

    </table>

</schema>
