<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote_request" resource="default" engine="innodb" comment="Quote Requests">
        <column xsi:type="int" name="quote_id" nullable="false" identity="true" unsigned="true" comment="Quote ID"/>
        <column xsi:type="int" name="cart_id" nullable="false" unsigned="true" comment="Cart ID"/>
        <column xsi:type="int" name="customer_id" nullable="true" unsigned="true" comment="Customer ID"/>
        <column xsi:type="boolean" name="customer_is_guest" nullable="false" comment="Customer Is Guest?"/>
        <column xsi:type="decimal" name="subtotal" precision="10" scale="2" nullable="false" comment="Subtotal"/>
        <column xsi:type="boolean" name="status" nullable="false" comment="Status"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <index referenceId="QUOTE_REQUEST_QUOTE_ID" indexType="btree">
            <column name="cart_id"/>
        </index>
        <index referenceId="QUOTE_REQUEST_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="quote_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_QUOTE_REQUEST_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID" table="quote_request" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="FK_QUOTE_REQUEST_CART_ID_QUOTE_ENTITY_ID" table="quote_request" column="cart_id" referenceTable="quote" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
    <table name="quote_request_detail" resource="default" engine="innodb" comment="Quote Request Details">
        <column xsi:type="int" name="detail_id" nullable="false" identity="true" unsigned="true" comment="Detail ID"/>
        <column xsi:type="int" name="quote_id" nullable="false" unsigned="true" comment="Quote ID"/>
        <column xsi:type="int" name="product_id" nullable="false" unsigned="true" comment="Product ID"/>
        <column xsi:type="int" name="product_sku" nullable="false" unsigned="true" comment="Product SKU"/>
        <column xsi:type="decimal" name="price" precision="10" scale="2" nullable="false" comment="Product Price"/>
        <column xsi:type="int" name="quantity" nullable="false" unsigned="true" comment="Quantity"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        <index referenceId="QUOTE_REQUEST_DETAIL_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
        <index referenceId="QUOTE_REQUEST_DETAIL_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="detail_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_QUOTE_REQUEST_DETAIL_QUOTE_ID_QUOTE_REQUEST_QUOTE_ID" table="quote_request_detail" column="quote_id" referenceTable="quote_request" referenceColumn="quote_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="FK_QUOTE_REQUEST_DETAIL_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID" table="quote_request_detail" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
</schema>
